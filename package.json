{
  "name": "zero-trust-translator",
  "version": "1.0.6",
  "private": true,
  "description": "Offline Chrome extension that maps Zero Trust usernames to real names, on the admin's own computer only.",
  "engines": {
    "node": "22.22.2"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build:check": "node scripts/build-check.mjs",
    "check-no-network": "node scripts/check-no-network.mjs dist",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/chrome": "^0.1.15",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
